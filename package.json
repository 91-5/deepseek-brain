{
  "name": "deepseek-brain",
  "version": "0.2.0",
  "description": "把 DeepSeek 网页版（无函数调用）包装成 OpenAI 兼容接口，供 OpenCode 作为 subagent 大脑使用。Windows only。",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/91-5/deepseek-brain.git" },
  "bugs": { "url": "https://github.com/91-5/deepseek-brain/issues" },
  "homepage": "https://github.com/91-5/deepseek-brain#readme",
  "os": ["win32"],
  "engines": { "node": ">=20" },
  "type": "module",
  "bin": { "deepseek-brain": "dist/cli.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./core": { "types": "./dist/core/index.d.ts", "default": "./dist/core/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md", "selectors.json"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": { "puppeteer-core": "24.43.1" },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^24.0.0"
  }
}